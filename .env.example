# Copy this file to .env and paste your keys after the = sign.
#   cp .env.example .env

# GitHub token (required): https://github.com/settings/tokens
# "Generate new token (classic)", no scopes needed for public repos.
GITHUB_TOKEN=

# Ranking model. The app checks for a local model first:
#   if Ollama (https://ollama.com) is running with a model installed, it is used
#   and no Groq key is needed. Otherwise the app uses Groq with this key.
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: pick a specific local model, e.g. llama3.1:8b
# (default: the first installed model). Change the host only if Ollama
# is not on the default port.
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
